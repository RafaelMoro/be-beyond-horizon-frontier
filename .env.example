# Copy to .env (gitignored). The owner's .env points at the PROD database (D16): local dev uses prod data.
# Tests never read these Mongo values; the e2e harness overrides them with a local replica set.
# Later stories add their own keys here, under the legacy names.

# Mongo, option A: a full connection string (wins over option B when set).
# MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0

# Mongo, option B: built as <MONGO_CONNECTION>://<user>:<pwd>@<MONGO_HOST>/?retryWrites=true&w=majority
MONGO_CONNECTION=mongodb+srv
MONGO_USER=your-user
MONGO_PWD=your-password
# Full host, e.g. <cluster>.<id>.mongodb.net
MONGO_HOST=your-cluster.example.mongodb.net

MONGO_DB_NAME=budget-master

# CORS origins: scheme required, no trailing slash.
FRONTEND_URI=http://localhost:5173
TEST_FRONTEND_URI=http://localhost:5174
DOMAIN_URI=https://example.com

# Mongoose autoIndex is on only when NODE_ENV=test.
NODE_ENV=development

# JWT keys (legacy names). JWT_KEY signs the access token (5d); ONE_TIME_JWT_KEY signs the reset-password token (1d).
# The old values are leaked (audit Critical): use rotated ones. PUBLIC_KEY is no longer read.
JWT_KEY=
ONE_TIME_JWT_KEY=

# Optional, defaults to 3000.
# PORT=3000

# Optional, e2e only: a local replica set. Without it the e2e run starts an in-memory one.
# MONGO_TEST_URI=mongodb://localhost:27017/?replicaSet=rs0
